# Copy to .env and fill in the values for your chosen mode.
# The server auto-selects: OAuth if the OAuth vars are set, else static bearer
# (HTTP) or PAT (stdio).

# --- PAT mode (local stdio, or the credential behind static-bearer HTTP) ------
# YNAB_PAT=your_personal_access_token

# --- Static bearer mode (self-host without OAuth) -----------------------------
# MCP_AUTH_TOKEN=generate_a_long_random_string   # e.g. `openssl rand -hex 32`

# --- OAuth mode ("Sign in with YNAB") -----------------------------------------
# YNAB_OAUTH_CLIENT_ID=your_ynab_oauth_app_client_id
# YNAB_OAUTH_CLIENT_SECRET=your_ynab_oauth_app_client_secret
# PUBLIC_URL=https://your-service-url            # no trailing slash
# MCP_TOKEN_SECRET=generate_with_ynab-mcp-gen-secret
# YNAB_OAUTH_SCOPE=read-only                     # optional; omit for full access

# --- Behaviour (any mode) -----------------------------------------------------
# YNAB_DEFAULT_PLAN_ID=your_plan_id              # lock to one plan; hides list-plans
# YNAB_READ_ONLY=true                            # disable all write tools
